{
  "name": "layersharedsession",
  "version": "0.1.0",
  "description": "A test of a shared-session layer for three.js WebXR sites: visitors in the same room see each other, peer to peer over WebRTC with Trystero, with no server of its own.",
  "keywords": ["webxr", "threejs", "multiplayer", "webrtc", "trystero", "p2p"],
  "homepage": "https://ariamokr.github.io/layersharedsession/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/layersharedsession.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/layersharedsession/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./session.js": "./public/js/session.js",
    "./pose.js": "./public/js/pose.js",
    "./shared.js": "./public/js/shared.js",
    "./identity.js": "./public/js/identity.js",
    "./room.js": "./public/js/room.js",
    "./package.json": "./package.json"
  },
  "files": [
    "public/js/session.js",
    "public/js/pose.js",
    "public/js/shared.js",
    "public/js/identity.js",
    "public/js/room.js",
    "tools/vendor.mjs"
  ],
  "scripts": {
    "postinstall": "node tools/vendor.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "three": "0.186.1"
  }
}
